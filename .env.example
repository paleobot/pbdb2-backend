# PBDB2 backend environment: the one .env for migrations/, payloadSchemas/ and api/.
# Copy to `.env` at the repository root and fill in. `.env` is never committed.
# Every area finds this file from its own source location, so commands work from
# any directory. Variables already set in the shell take precedence.

# --- PostgreSQL (target database; read by every area) ---
# Required by the migrations, the payload-schema DB tests and the API's
# DB-backed reads. Without them the API serves stub data and `npm test` still
# runs (the payload-schema DB tests fail, by design).
PG_HOST=localhost
PG_PORT=5432
PG_USER=
PG_PASSWORD=
PG_DATABASE=pbdb
# Optional: CA certificate path; its presence enables SSL. A relative path is
# resolved against the repository root, so this selects the committed AWS RDS
# bundle from any directory. An absolute path is used as given.
# PG_CA_CERT=global-bundle.pem

# --- MariaDB (legacy PBDB Classic source; migrations only) ---
MARIADB_HOST=localhost
MARIADB_PORT=3306
MARIADB_USER=
MARIADB_PASSWORD=
MARIADB_DATABASE=pbdb_archive

# --- PBot API (the pbot-* migration steps) ---
PBOT_TOKEN=

# --- Migrations, optional ---
# Reference database built by migrations/src/opinions-migration/tests/run-reference-handlers.js.
# PG_REF_DATABASE=pbdb_ref
# Same as passing --dry-run to migrate-collections.js.
# DRY_RUN=1

# --- API server ---
# HOST=0.0.0.0
# PORT=3000
# NODE_ENV=development

# --- API integration tests (`npm run test:integration`) ---
# They connect with the PG_* above and need a role permitted to CREATE/DROP
# DATABASE (each run provisions an ephemeral pbdb2_test_<random> database).
# They load the DDL from db/ at the repository root; override only if needed:
# DDL_DIR=/abs/path/to/db
